# Copy to `.env` and adjust as needed. `.env` is git-ignored.

# MinIO settings
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_VOLUME_DIR=./volume/minio-data/

# Postgres settings
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=postgres
POSTGRES_VOLUME_DIR=./volume/db-data/
TZ=Europe/Copenhagen

# Lakekeeper settings
LAKEKEEPER_DB_USER=lakekeeper
LAKEKEEPER_DB_PASSWORD=lakekeeper123!
S3_LAKEKEEPER_USER=lakekeeper
S3_LAKEKEEPER_PASSWORD=LKpassw0rd!

# Trino settings
S3_TRINO_USER=trino
S3_TRINO_PASSWORD=TRpassw0rd!

# Hive Metastore settings
